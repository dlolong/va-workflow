{
  "name": "va-relay",
  "version": "1.0.0-starter",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/unit/*.test.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build",
    "check:env": "node scripts/check-env.mjs",
    "format": "prettier --write .",
    "check:syntax": "node scripts/check-syntax.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "2.117.2",
    "zod": "^4.1.0",
    "luxon": "^3.7.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/luxon": "^3.7.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "prettier": "^3.6.2",
    "@tailwindcss/postcss": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "pg": "^8.16.3"
  }
}
