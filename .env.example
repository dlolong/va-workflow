# Required. Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only: required only for automatic schedules/reminders/email delivery.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Optional transactional notification provider. Auth emails use Supabase SMTP separately.
RESEND_API_KEY=
EMAIL_FROM=
# Local integration tests only. Never point this at production.
TEST_DATABASE_URL=
# Live browser test accounts (optional; use a disposable staging project).
E2E_EMAIL=
E2E_PASSWORD=
